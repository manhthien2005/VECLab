# Supabase project — local/preview/production (docs/system-architecture.md §3.2)
# Copy to `.env.local`. Never commit real values.
# These two public variables connect email/password Auth.
# See docs/workflow/auth-setup.md for redirect URLs, email and rebuild requirements.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# The following server-only values also support saving simulation attempts to the cloud.
SUPABASE_SECRET_KEY=replace-with-secret-key

# Server-only secret used to sign/verify simulation commit requests
SIMULATION_COMMIT_SECRET=replace-with-random-64-hex

# Canonical scenario release registry is versioned in-repo; this pins the
# release a deployment serves so engine, scoring, state, content and evidence
# move together (docs/system-architecture.md §6.2).
SCENARIO_RELEASE_CHANNEL=stable
