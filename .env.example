# Supabase local. Run npm ci then npm run demo:setup to generate .env.local.
# No hosted credentials are needed for the local demo.
# These two public variables connect email/password Auth.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only local key for account/profile operations. Never use NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
